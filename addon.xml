<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.tvfree" name="TV Free" version="1.0.10" provider-name="Jarko">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="sk">Sledovanie slovenských a českých TV staníc.</summary>
        <description lang="sk">Doplnok TV Free na sledovanie živého vysielania a generovanie M3U playlistu pre PVR IPTV Simple Client.</description>
        <language>sk</language>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
